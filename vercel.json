{
  "outputDirectory": "dist",
  "buildCommand": "npx expo export --platform web",
  "framework": null,
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/snapshot-prices",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/news-push",
      "schedule": "0 16 * * *"
    }
  ]
}
