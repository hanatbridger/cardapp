{
  "outputDirectory": "dist",
  "buildCommand": "npx expo export --platform web",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/snapshot-prices",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/news-push",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/justtcg-refresh",
      "schedule": "30 13 * * *"
    }
  ]
}
