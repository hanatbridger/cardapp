# Expo public env vars — embedded in the client bundle at build time.
# Copy this file to `.env` and fill in real values for local dev.
# For TestFlight / prod, set these in EAS secrets and in the Vercel project.

# Sentry crash + performance telemetry.
# Get from: https://sentry.io/settings/<org>/projects/cardpulse/keys/
EXPO_PUBLIC_SENTRY_DSN=

# RevenueCat public SDK key (iOS).
# Get from: https://app.revenuecat.com/projects/<id>/apps
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Pokemon TCG API key. Optional but strongly recommended: keyless clients
# get the throttled tier (slow responses, load-shed 500s). Free key from:
# https://dev.pokemontcg.io
EXPO_PUBLIC_POKEMONTCG_API_KEY=

# ── SERVER-ONLY (Vercel project env, NOT the client bundle) ──────────────
# These power the edge functions in api/. They must be set in the Vercel
# project settings (Production + Preview). They are NOT EXPO_PUBLIC_ and
# must never ship in the app bundle. Without them the price-history
# snapshot cron (api/cron/snapshot-prices.ts) is rejected and writes
# nothing — which leaves every card's chart stuck on "Price history is
# building".

# Supabase project URL (same project as the client) and the SERVICE ROLE
# key (bypasses RLS for the snapshot writes — keep secret, server only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the cron. Set the same value here AND let Vercel
# inject it: when CRON_SECRET is set in the project env, Vercel sends
# `Authorization: Bearer <CRON_SECRET>` on each scheduled invocation.
CRON_SECRET=
