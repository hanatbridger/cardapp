{
  "expo": {
    "name": "CardPulse",
    "slug": "CardPulse",
    "version": "1.0.14",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cardpulse",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5739FF"
    },
    "ios": {
      "bundleIdentifier": "com.getcardpulse.app",
      "buildNumber": "2",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.getcardpulse.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4B5EFC"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "privacy": "https://strange-saha.vercel.app/privacy",
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#4B5EFC"
        }
      ],
      "@sentry/react-native",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.864170396383-4da514g9biulc0374haev0khj9iing07"
        }
      ],
      "expo-web-browser",
      "./plugins/withModularHeaders.js",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "CardPulse uses your photo library only to attach a screenshot to feedback you send us."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2aae8829-2a01-4d59-8e95-7219841e27a0"
      }
    },
    "owner": "hanwongz"
  }
}
